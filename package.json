{
  "name": "secb",
  "version": "0.3.0-alpha.0",
  "private": true,
  "description": "Local-first governed agent work and learning control plane",
  "type": "module",
  "main": "src/index.mjs",
  "exports": "./src/index.mjs",
  "bin": {
    "secb": "./tools/secb.mjs",
    "secb-graph": "./tools/secb-graph.mjs",
    "secb-skills": "./tools/secb-skills.mjs",
    "secb-mcp-config": "./tools/secb-mcp-config.mjs",
    "secb-mcp-doctor": "./tools/secb-mcp-doctor.mjs"
  },
  "scripts": {
    "dev": "npm --prefix dashboard run dev",
    "secb:graph": "node tools/secb-graph.mjs",
    "secb:skills": "node tools/secb-skills.mjs",
    "secb:mcp-config": "node tools/secb-mcp-config.mjs",
    "secb:mcp-doctor": "node tools/secb-mcp-doctor.mjs",
    "secb": "node tools/secb.mjs",
    "validate": "node tools/validate-foundation.mjs",
    "test": "npm run validate && node --test tests/*.test.mjs",
    "secb:queue": "node tools/secb-queue.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
