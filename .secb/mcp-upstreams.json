{
  "schema_version": "1.0",
  "registry_id": "secb-mcp-upstreams",
  "description": "Migrated from bizera-win-mcp-hub config/servers.yaml. Every entry was probed on 2026-07-30 from WSL; verified_status records what was observed, and entries whose target no longer exists are carried disabled rather than dropped so the migration stays auditable. Exception: sqlite-bst-intel was dropped outright on operator instruction 2026-07-30 (its --db-path target /opt/bst_Intel_VC/memory/memory.db does not exist).",
  "wsl_distro": "bizera-wsl",
  "upstreams": [
    {
      "id": "windows-mcp",
      "description": "Windows desktop automation",
      "enabled": true,
      "transport": "stdio",
      "runtime": "windows",
      "command": "python",
      "args": ["-m", "windows_mcp"],
      "classification_ceiling": "INTERNAL",
      "verified_status": "unverified",
      "note": "Windows-only. Not probed: WSL->Windows interop was unavailable during migration."
    },
    {
      "id": "filesystem-opt",
      "description": "WSL filesystem bridge (/opt)",
      "enabled": true,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/opt"],
      "classification_ceiling": "INTERNAL",
      "verified_status": "reachable"
    },
    {
      "id": "filesystem-bst-intel",
      "description": "BST Intel VC filesystem",
      "enabled": true,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/opt/bst_Intel_VC"],
      "classification_ceiling": "INTERNAL",
      "verified_status": "reachable",
      "note": "Path corrected. servers.yaml pointed at /opt/bst_intel_vc, a distinct 5-entry stub directory (different inode); the real 35-entry repository is /opt/bst_Intel_VC."
    },
    {
      "id": "wsl-shell",
      "description": "WSL shell access",
      "enabled": true,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "npx",
      "args": ["-y", "@mkusaka/mcp-shell-server"],
      "classification_ceiling": "INTERNAL",
      "verified_status": "reachable",
      "note": "Arbitrary command execution inside the distro. Carried enabled at parity with servers.yaml; review before fronting it through SecB."
    },
    {
      "id": "sequentialthinking",
      "description": "Sequential Thinking MCP",
      "enabled": true,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "classification_ceiling": "PUBLIC",
      "verified_status": "reachable"
    },
    {
      "id": "ddg-search",
      "description": "DuckDuckGo search and content fetch",
      "enabled": true,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "classification_ceiling": "PUBLIC",
      "verified_status": "reachable",
      "note": "servers.yaml ran this on the Windows host. Pinned to wsl because uvx was verified there and not on Windows."
    },
    {
      "id": "time",
      "description": "Time server",
      "enabled": true,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-server-time"],
      "env": { "LOCAL_TIMEZONE": "Asia/Bangkok" },
      "classification_ceiling": "PUBLIC",
      "verified_status": "reachable",
      "note": "mcp<2 pinned: the Python MCP SDK 2.0.0 renamed McpError to MCPError, and this server still imports the old name. Unpinned it exits 1 on import."
    },
    {
      "id": "fetch",
      "description": "HTTP fetch",
      "enabled": true,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-server-fetch"],
      "classification_ceiling": "PUBLIC",
      "verified_status": "reachable",
      "note": "mcp<2 pinned for the same SDK 2.0.0 McpError/MCPError rename as the time upstream."
    },
    {
      "id": "git-bst-intel",
      "description": "Git for BST Intel VC",
      "enabled": true,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-server-git", "--repository", "/opt/bst_Intel_VC"],
      "classification_ceiling": "INTERNAL",
      "verified_status": "reachable",
      "note": "Path corrected to /opt/bst_Intel_VC, which is the directory that actually carries .git. mcp<2 pinned for the same SDK 2.0.0 rename as the time upstream."
    },
    {
      "id": "bizera-smartthink",
      "description": "Direct access to the legacy BST organism root",
      "enabled": false,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/opt/bst-sa"],
      "classification_ceiling": "INTERNAL",
      "verified_status": "unreachable",
      "note": "servers.yaml targeted /opt/bizera-smartthink, which no longer exists; the root was renamed /opt/bst-sa. Args retargeted but left disabled because superseding this entry with filesystem-opt is an operator decision."
    },
    {
      "id": "bst-memory",
      "description": "BST Intel memory (OpenMemory)",
      "enabled": false,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "python3",
      "args": ["-m", "bst_intel.memory.openmemory.mcp_bridge"],
      "env": { "PYTHONPATH": "/opt" },
      "classification_ceiling": "CONFIDENTIAL",
      "verified_status": "unreachable",
      "note": "ModuleNotFoundError: No module named 'bst_intel' under PYTHONPATH=/opt."
    },
    {
      "id": "bst-intel-memory",
      "description": "BST Intel VC sovereignty memory with semantic search",
      "enabled": false,
      "transport": "stdio",
      "runtime": "wsl",
      "command": "bash",
      "args": ["-lic", "cd /opt/bst_intel_vc/mcp/memory_server && source .venv/bin/activate && python -m bst_mcp_memory.runtime.mcp_server"],
      "classification_ceiling": "CONFIDENTIAL",
      "verified_status": "unreachable",
      "note": "/opt/bst_intel_vc/mcp/memory_server does not exist."
    },
    {
      "id": "bst-core",
      "description": "BizEra SmartThink core SSE provider",
      "enabled": false,
      "transport": "sse",
      "runtime": "wsl",
      "url": "http://localhost:8020/sse?provider=bst-core",
      "classification_ceiling": "INTERNAL",
      "verified_status": "unreachable",
      "note": "No listener on port 8020."
    },
    {
      "id": "bst-plane",
      "description": "BizEra SmartThink plane SSE provider",
      "enabled": false,
      "transport": "sse",
      "runtime": "wsl",
      "url": "http://localhost:8020/sse?provider=bst-plane",
      "classification_ceiling": "INTERNAL",
      "verified_status": "unreachable",
      "note": "No listener on port 8020."
    },
    {
      "id": "shell-sse",
      "description": "Shell SSE provider",
      "enabled": false,
      "transport": "sse",
      "runtime": "wsl",
      "url": "http://localhost:8020/sse?provider=shell",
      "classification_ceiling": "INTERNAL",
      "verified_status": "unreachable",
      "note": "No listener on port 8020."
    },
    {
      "id": "bstah-skills",
      "description": "bstAH MCP skills gateway",
      "enabled": false,
      "transport": "http",
      "runtime": "wsl",
      "url": "http://127.0.0.1:8010/mcp",
      "classification_ceiling": "INTERNAL",
      "verified_status": "unreachable",
      "note": "No listener on port 8010."
    }
  ]
}
