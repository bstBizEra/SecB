# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Local environment and secrets
.env
.env.*
*.env
!.env.example

# Runtime and editor state
.secb/runtime/
.vscode/
.idea/
.claude/
.codex/
.claude-flow/
