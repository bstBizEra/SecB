{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/project-contract.schema.json",
  "title": "SecB Project Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "version", "profile_id", "status", "owners", "repositories", "risk_class", "evidence_destination", "valid_from", "valid_until", "approvals"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "REVIEW", "APPROVED_NOT_EFFECTIVE", "ACTIVE", "SUSPENDED", "CLOSED", "REVOKED"]},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "repositories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risk_class": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "evidence_destination": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "approvals": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
