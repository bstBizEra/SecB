{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/local-bridge-session.schema.json",
  "title": "SecB Local Bridge Session Record",
  "description": "Server-derived local-bridge session metadata. The record carries no bearer credential and repository presence grants no session authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "handshake_id",
    "proof_id",
    "harness_installation_id",
    "runtime_deployment_id",
    "service_instance_id",
    "authority_domain_id",
    "protocol_version",
    "authority_source",
    "proof_verification_status",
    "replay_commit_status",
    "authorization_reference",
    "lifecycle_state",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "session_id": {
      "type": "string",
      "pattern": "^brsess_[A-Za-z0-9][A-Za-z0-9._-]{7,95}$"
    },
    "handshake_id": {
      "type": "string",
      "pattern": "^bhs_[A-Za-z0-9][A-Za-z0-9._-]{7,95}$"
    },
    "proof_id": {
      "type": "string",
      "pattern": "^brproof_[A-Za-z0-9][A-Za-z0-9._-]{7,95}$"
    },
    "harness_installation_id": {
      "type": "string",
      "pattern": "^inst_[A-Za-z0-9][A-Za-z0-9._-]{7,95}$"
    },
    "runtime_deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "service_instance_id": {
      "type": "string",
      "pattern": "^svc_[A-Za-z0-9][A-Za-z0-9._-]{7,95}$"
    },
    "authority_domain_id": {
      "type": "string",
      "pattern": "^authdom_[A-Za-z0-9][A-Za-z0-9._-]{7,95}$"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}$"
    },
    "authority_source": {
      "const": "SERVER_DERIVED"
    },
    "proof_verification_status": {
      "enum": ["NOT_VERIFIED", "VERIFIED", "FAILED"]
    },
    "replay_commit_status": {
      "enum": ["NOT_COMMITTED", "COMMITTED"]
    },
    "authorization_reference": {
      "type": ["string", "null"],
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "lifecycle_state": {
      "enum": [
        "CANDIDATE",
        "ACTIVE",
        "EXPIRED",
        "REVOKED",
        "CLOSED"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_state": { "const": "ACTIVE" }
        },
        "required": ["lifecycle_state"]
      },
      "then": {
        "properties": {
          "proof_verification_status": { "const": "VERIFIED" },
          "replay_commit_status": { "const": "COMMITTED" },
          "authorization_reference": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": { "const": "CANDIDATE" }
        },
        "required": ["lifecycle_state"]
      },
      "then": {
        "properties": {
          "proof_verification_status": { "const": "NOT_VERIFIED" },
          "replay_commit_status": { "const": "NOT_COMMITTED" },
          "authorization_reference": { "type": "null" }
        }
      }
    }
  ]
}
