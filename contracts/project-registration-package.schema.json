{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/project-registration-package.schema.json",
  "title": "SecB Project Registration Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "registration_id",
    "version",
    "status",
    "mode",
    "repository_mutation_authorized",
    "identity",
    "proposed_changes",
    "prohibited_actions",
    "created_at"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "registration_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": [
        "DISCOVERED",
        "REGISTRATION_INTAKE",
        "ANALYSIS_IN_PROGRESS",
        "REGISTRATION_PACKAGE_DRAFTED",
        "REVIEW_REQUIRED",
        "REGISTERED_PROPOSAL_ONLY",
        "BOOTSTRAP_AUTHORIZATION_PENDING",
        "AUTHORIZED_FOR_BOOTSTRAP",
        "BOOTSTRAPPED",
        "AUTHORIZED_FOR_IMPLEMENTATION"
      ]
    },
    "mode": { "type": "string", "const": "proposal_only" },
    "repository_mutation_authorized": { "type": "boolean" },
    "identity": {
      "type": "object",
      "required": ["name", "owners", "classification"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "classification": {
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        },
        "repository_url": { "type": "string" },
        "default_branch": { "type": "string" }
      }
    },
    "proposed_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "action", "status", "rationale"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "action": { "enum": ["create", "modify", "delete"] },
          "status": { "enum": ["proposed", "approved", "rejected"] },
          "rationale": { "type": "string", "minLength": 1 },
          "canonical_hash": { "type": "string" }
        }
      }
    },
    "prohibited_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
