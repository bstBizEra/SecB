{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/skill-candidate.schema.json",
  "title": "SecB Skill Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_candidate_id",
    "version",
    "name",
    "purpose",
    "status",
    "source_identity",
    "immutable_version",
    "integrity",
    "tool_inventory",
    "filesystem_boundary",
    "network_boundary",
    "credential_handle",
    "harness_compatibility",
    "intake_evidence_refs",
    "withdrawal"
  ],
  "properties": {
    "skill_candidate_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "status": { "enum": ["CANDIDATE", "WITHDRAWN"] },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maintainer", "repository", "namespace"],
      "properties": {
        "maintainer": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }
      }
    },
    "immutable_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag_or_digest"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "tag_or_digest": { "type": "string", "minLength": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "tool_inventory": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "filesystem_boundary": { "type": "string", "minLength": 1 },
    "network_boundary": { "type": "string", "minLength": 1 },
    "credential_handle": { "type": ["string", "null"], "minLength": 1 },
    "harness_compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["harness_id", "compatibility_level"],
        "properties": {
          "harness_id": { "type": "string", "minLength": 1 },
          "compatibility_level": { "enum": ["C0", "C1", "C2", "C3", "C4", "C5"] }
        }
      }
    },
    "intake_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "withdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["withdrawn", "reason"],
      "properties": {
        "withdrawn": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
