{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/local-bridge-lifecycle.schema.json",
  "title": "SecB Local Bridge Lifecycle Transition",
  "description": "Candidate lifecycle transition record. Only a separately authorized service-side transition engine may make an accepted transition effective.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle_event_id",
    "subject_type",
    "subject_id",
    "from_state",
    "to_state",
    "decision_status",
    "authority_reference",
    "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "lifecycle_event_id": {
      "type": "string",
      "pattern": "^brlife_[A-Za-z0-9][A-Za-z0-9._-]{7,95}$"
    },
    "subject_type": {
      "enum": ["SERVICE", "LOCATOR", "BRIDGE", "SESSION"]
    },
    "subject_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "from_state": {
      "enum": [
        "ABSENT",
        "CANDIDATE",
        "READY",
        "ACTIVE",
        "DEGRADED",
        "STOPPING",
        "CLOSED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "to_state": {
      "enum": [
        "CANDIDATE",
        "READY",
        "ACTIVE",
        "DEGRADED",
        "STOPPING",
        "CLOSED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "decision_status": {
      "enum": ["CANDIDATE_NOT_EFFECTIVE", "AUTHORIZED", "DENIED"]
    },
    "authority_reference": {
      "type": ["string", "null"],
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_status": { "const": "AUTHORIZED" }
        },
        "required": ["decision_status"]
      },
      "then": {
        "properties": {
          "authority_reference": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": { "const": "CANDIDATE_NOT_EFFECTIVE" }
        },
        "required": ["decision_status"]
      },
      "then": {
        "properties": {
          "authority_reference": { "type": "null" }
        }
      }
    }
  ]
}
