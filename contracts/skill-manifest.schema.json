{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/skill-manifest.schema.json",
  "title": "SecB Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "version", "name", "status", "owner", "source", "purpose", "supported_runtimes", "project_scopes", "max_data_classification", "evidence_refs", "approval_history", "revocation_conditions"],
  "properties": {
    "skill_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["CANDIDATE", "SANDBOX", "EVALUATION", "REVIEW", "PUBLISHED", "DEPRECATED", "REVOKED", "QUARANTINED"]},
    "owner": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "licence"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "minLength": 1},
        "licence": {"type": "string", "minLength": 1}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "supported_runtimes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "project_scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "max_data_classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approval_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "decision_type", "approved_by", "approved_at"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "decision_type": {"enum": ["SANDBOX_ENTRY", "EVALUATION_PASS", "SECURITY_REVIEW", "INDEPENDENT_REV", "INDEPENDENT_QA", "HUMAN_PROMOTION", "REVOCATION"]},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "revocation_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
