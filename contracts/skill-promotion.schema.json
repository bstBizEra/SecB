{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/skill-promotion.schema.json",
  "title": "SecB Skill Promotion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "version",
    "project_id",
    "work_package_id",
    "session_id",
    "actor_id",
    "skill_candidate_id",
    "skill_version",
    "status",
    "producer_actor_id",
    "independent_review_actor_id",
    "governance_actor_id",
    "bound_action",
    "bound_object_version",
    "evidence_refs",
    "risk_class",
    "decided_at",
    "content_hash"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "work_package_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "skill_candidate_id": { "type": "string", "minLength": 1 },
    "skill_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PUBLISHED"] },
    "producer_actor_id": { "type": "string", "minLength": 1 },
    "independent_review_actor_id": { "type": "string", "minLength": 1 },
    "governance_actor_id": { "type": "string", "minLength": 1 },
    "bound_action": { "type": "string", "minLength": 1 },
    "bound_object_version": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_class": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
