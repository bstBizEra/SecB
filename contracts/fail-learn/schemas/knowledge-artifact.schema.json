{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/fail-learn/v1/knowledge-artifact.schema.json",
  "title": "SecB Knowledge Artifact (WP1 deliverable 4)",
  "description": "Formalizes SECB-FAIL-LEARN-001 section 9 (KCS v6-inspired knowledge lifecycle, K0/K1) as strict JSON Schema. Matrix row 3: positive proof 'Reviewed lineage advances to K1'; negative proof 'Missing reviewer, scope, or evidence rejects'. LIMITATION deferred to semantic-validator.mjs: whether any reviewer_id in `reviewers` is actually distinct from author_actor_id or from the source Experience Record's source_actor_id/checker_id -- JSON Schema without $data cannot compare a nested array element's field against a sibling top-level field's value. validateIndependentKnowledgeReview performs that cross-field/cross-document comparison (SCEN-08). validateNoDerivationFromDeprecatedKnowledge (SCEN-14) is likewise semantic-only: it is exercised from the Skill Candidate side (a skill candidate's knowledge_maturity_at_binding claim is cross-checked against this document's actual maturity_state).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "knowledge_id", "maturity_state", "scope", "applicability", "symptoms", "diagnosis",
    "verified_cause", "resolution", "prevention", "unsafe_shortcuts", "permissions_required",
    "evidence_refs", "experience_refs", "reviewers", "author_actor_id", "confidence", "validity",
    "supersedes", "superseded_by", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "knowledge_id": { "type": "string", "pattern": "^know_[0-9a-f]{64}$" },
    "maturity_state": { "enum": ["K0", "K1", "DEPRECATED", "SUPERSEDED", "REJECTED"] },
    "scope": { "$ref": "common.schema.json#/$defs/tenant_scope" },
    "applicability": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "symptoms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "diagnosis": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "verified_cause": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "resolution": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "prevention": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "unsafe_shortcuts": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "permissions_required": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/action_class" } },
    "evidence_refs": { "$ref": "common.schema.json#/$defs/nonempty_reference_list" },
    "experience_refs": { "$ref": "common.schema.json#/$defs/nonempty_reference_list" },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "reviewed_at", "verdict"],
        "properties": {
          "reviewer_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "reviewed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "verdict": { "enum": ["APPROVED", "REJECTED"] }
        }
      }
    },
    "author_actor_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_from", "review_due", "valid_until"],
      "properties": {
        "valid_from": { "$ref": "common.schema.json#/$defs/timestamp" },
        "review_due": { "$ref": "common.schema.json#/$defs/timestamp" },
        "valid_until": { "oneOf": [ { "type": "null" }, { "$ref": "common.schema.json#/$defs/timestamp" } ] }
      }
    },
    "supersedes": { "oneOf": [ { "type": "null" }, { "$ref": "common.schema.json#/$defs/reference" } ] },
    "superseded_by": { "oneOf": [ { "type": "null" }, { "$ref": "common.schema.json#/$defs/reference" } ] },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "description": "SCEN-08 / matrix row 3: a lesson cannot become knowledge without independent review -- K1 requires at least one reviewer verdict, and that verdict must be APPROVED (schema-provable: 'contains'). Which reviewer id counts as independent of the author is a semantic-validator concern (see description above).",
      "if": { "type": "object", "required": ["maturity_state"], "properties": { "maturity_state": { "const": "K1" } } },
      "then": {
        "type": "object",
        "properties": {
          "reviewers": {
            "type": "array",
            "minItems": 1,
            "contains": { "type": "object", "properties": { "verdict": { "const": "APPROVED" } } }
          }
        }
      }
    },
    {
      "description": "DEPRECATED/SUPERSEDED knowledge must name what superseded it (section 9: 'Interpretation may be revised; sealed evidence may not' -- supersession is append-only, not overwrite).",
      "if": { "type": "object", "required": ["maturity_state"], "properties": { "maturity_state": { "enum": ["DEPRECATED", "SUPERSEDED"] } } },
      "then": { "type": "object", "properties": { "superseded_by": { "not": { "type": "null" } } } }
    }
  ]
}
