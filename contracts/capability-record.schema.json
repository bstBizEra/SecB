{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/capability-record.schema.json",
  "title": "SecB Capability Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "version",
    "adapter_id",
    "tool",
    "access",
    "status",
    "source_identity",
    "immutable_version",
    "integrity",
    "tool_inventory",
    "filesystem_boundary",
    "network_boundary",
    "credential_handle",
    "intake_evidence_refs",
    "approvals",
    "revocation"
  ],
  "properties": {
    "capability_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "adapter_id": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "access": { "enum": ["read", "mutate", "destructive", "external"] },
    "status": { "enum": ["CANDIDATE", "PROMOTED", "REVOKED"] },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maintainer", "repository", "namespace"],
      "properties": {
        "maintainer": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }
      }
    },
    "immutable_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag_or_digest"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "tag_or_digest": { "type": "string", "minLength": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "tool_inventory": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "filesystem_boundary": { "type": "string", "minLength": 1 },
    "network_boundary": { "type": "string", "minLength": 1 },
    "credential_handle": { "type": ["string", "null"], "minLength": 1 },
    "intake_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "actor_id", "decided_at"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "actor_id": { "type": "string", "minLength": 1 },
          "decided_at": { "type": "string", "format": "date-time" }
        }
      },
      "default": []
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revoked", "reason", "known_bad_versions"],
      "properties": {
        "revoked": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "minLength": 1 },
        "known_bad_versions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    }
  }
}
