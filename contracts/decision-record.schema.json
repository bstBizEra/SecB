{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/decision-record.schema.json",
  "title": "SecB Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "version", "project_id", "work_package_id", "session_id", "actor_id", "decision_type", "outcome", "rationale", "authority_ref", "evidence_refs", "decided_at", "valid_from", "valid_until"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "minLength": 1},
    "work_package_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "decision_type": {"enum": ["GOVERNANCE", "AUTHORITY", "DISPOSITION", "REVERSION"]},
    "outcome": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "authority_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decided_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "reverts": {"type": "string", "minLength": 1}
  }
}
