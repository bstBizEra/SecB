{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/decision-record.schema.json",
  "title": "SecB Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "version",
    "project_id",
    "work_package_id",
    "session_id",
    "actor_id",
    "decision_type",
    "outcome",
    "rationale",
    "authority_ref",
    "evidence_refs",
    "decided_at",
    "valid_from",
    "valid_until"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "work_package_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_type": {
      "enum": [
        "GOVERNANCE",
        "AUTHORITY",
        "DISPOSITION",
        "REVERSION"
      ]
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "reverts": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "description": "What this decision authorizes. OPTIONAL at the schema level so no existing decision record is invalidated; MANDATORY at every authorization consumer, which denies when it is absent. A decision without a subject authorizes nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SKILL_VERSION",
            "WORK_PACKAGE",
            "PROJECT_CONTRACT",
            "AGENT_REGISTRATION",
            "RUNTIME_DEPLOYMENT"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "grant": {
          "description": "The authorized ceiling, compared field-by-field at resolution against the registered manifest. Absent it, identity binds but self-widening does not.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_scopes",
            "supported_runtimes",
            "max_data_classification"
          ],
          "properties": {
            "project_scopes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "supported_runtimes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "max_data_classification": {
              "enum": [
                "PUBLIC",
                "INTERNAL",
                "CONFIDENTIAL",
                "RESTRICTED"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SKILL_VERSION"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "grant": {
                "type": "object"
              }
            },
            "required": [
              "version",
              "grant"
            ]
          }
        }
      ]
    }
  }
}
