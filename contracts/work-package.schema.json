{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/work-package.schema.json",
  "title": "SecB Work Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_package_id", "version", "project_id", "objective", "risk_class", "status", "baseline", "scope", "non_scope", "acceptance_criteria", "roles", "allowed_paths", "prohibited_paths", "evidence_obligations", "valid_until"],
  "properties": {
    "work_package_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "risk_class": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "status": {"enum": ["DRAFT", "PLANNED", "REVIEWED", "AUTHORIZED", "READY", "RUNNING", "SELF_VERIFIED", "REVIEW", "QA", "GOV_DECISION", "ACCEPTED", "REWORK", "BLOCKED", "QUARANTINED", "CANCELLED"]},
    "baseline": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "roles": {"type": "object", "minProperties": 1},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_obligations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "valid_until": {"type": "string", "format": "date-time"}
  }
}
