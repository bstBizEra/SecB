{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secb.local/contracts/knowledge-claim.schema.json",
  "title": "SecB Knowledge Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "version", "project_id", "work_package_id", "session_id", "actor_id", "statement", "derivation", "truth_status", "evidence_refs", "claimed_at", "valid_from", "valid_until", "retention_policy"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "minLength": 1},
    "work_package_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "derivation": {"type": "string", "minLength": 1},
    "truth_status": {"enum": ["verified_true", "verified_false", "partially_supported", "conflicted", "unverified", "outdated"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claimed_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "retention_policy": {"type": "string", "minLength": 1}
  }
}
