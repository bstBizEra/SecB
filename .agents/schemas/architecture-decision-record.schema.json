{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision_id",
    "title",
    "status",
    "context",
    "options",
    "decision",
    "consequences",
    "evidence_refs",
    "owner"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "review-required",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ]
    },
    "context": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "summary"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 2
    },
    "decision": {
      "type": "string"
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "approver": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
